<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="MCP" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/MCP" prefix_auto="0" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option host_application="../tSIP/tSIP/Debug_Build/tSIP.exe" />
				<Option run_host_application_in_terminal="0" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/MCP" prefix_auto="0" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option host_application="../tSIP/tSIP/Release_Build/tSIP.exe" />
				<Option run_host_application_in_terminal="0" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-Os" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++17" />
			<Add option="-Wall" />
			<Add option="-Wextra" />
			<Add option="-DWIN32_LEAN_AND_MEAN" />
			<Add option="-D_WIN32_WINNT=0x0601" />
			<Add directory="jsoncpp/include" />
			<Add directory="../tSIP/tSIP/phone" />
		</Compiler>
		<Linker>
			<Add option="-static" />
			<Add option="-Wl,--add-stdcall-alias" />
			<Add library="ws2_32" />
			<Add library="bcrypt" />
			<Add library="user32" />
		</Linker>
		<Unit filename="Activity.cpp" />
		<Unit filename="Activity.h" />
		<Unit filename="CallWatch.cpp" />
		<Unit filename="CallWatch.h" />
		<Unit filename="Config.cpp" />
		<Unit filename="Config.h" />
		<Unit filename="Host.h" />
		<Unit filename="HttpServer.cpp" />
		<Unit filename="HttpServer.h" />
		<Unit filename="Makefile" />
		<Unit filename="McpServer.cpp" />
		<Unit filename="McpServer.h" />
		<Unit filename="Prompts.cpp" />
		<Unit filename="Prompts.h" />
		<Unit filename="README.md" />
		<Unit filename="SettingsDialog.cpp" />
		<Unit filename="SettingsDialog.h" />
		<Unit filename="Tools.cpp" />
		<Unit filename="Tools.h" />
		<Unit filename="build.bat" />
		<Unit filename="jsoncpp/include/json/json.h" />
		<Unit filename="jsoncpp/include/json/reader.h" />
		<Unit filename="jsoncpp/include/json/value.h" />
		<Unit filename="jsoncpp/include/json/writer.h" />
		<Unit filename="jsoncpp/src/lib_json/json_reader.cpp">
			<Option compiler="gcc" use="1" buildCommand="$compiler $options -Wno-unused-parameter $includes -c $file -o $object" />
		</Unit>
		<Unit filename="jsoncpp/src/lib_json/json_value.cpp">
			<Option compiler="gcc" use="1" buildCommand="$compiler $options -Wno-unused-parameter $includes -c $file -o $object" />
		</Unit>
		<Unit filename="jsoncpp/src/lib_json/json_writer.cpp">
			<Option compiler="gcc" use="1" buildCommand="$compiler $options -Wno-unused-parameter $includes -c $file -o $object" />
		</Unit>
		<Unit filename="main.cpp" />
		<Unit filename="../tSIP/tSIP/phone/tSIP_plugin_v2.h" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
